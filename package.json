{
  "name": "deepseek-api-proxy",
  "version": "0.1.0",
  "description": "Unofficial OpenAI-compatible API for chat.deepseek.com",
  "type": "module",
  "bin": {
    "ds": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/vendor','dist/vendor',{recursive:true})\"",
    "dev": "tsx src/cli.ts",
    "ds": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
